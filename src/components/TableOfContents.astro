---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// Only h2 / h3 make a useful rail.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <aside class="sticky top-[54px] hidden max-h-[calc(100vh-54px)] self-start overflow-auto border-l border-line-soft py-8 pl-7 pr-6 text-xs xl:block">
      <div class="kicker mb-3.5">On this page</div>
      <nav id="toc">
        {items.map((h) => (
          <a
            href={`#${h.slug}`}
            data-slug={h.slug}
            class:list={[
              "block border-l-2 border-transparent py-1 text-muted no-underline hover:text-ink hover:no-underline",
              h.depth === 3 ? "pl-5 text-[11.5px]" : "pl-2.5",
            ]}
          >
            {h.text}
          </a>
        ))}
      </nav>
    </aside>
  )
}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#toc a[data-slug]")
  );
  if (links.length) {
    const map = new Map(links.map((l) => [l.dataset.slug, l]));
    const setActive = (slug: string | null) => {
      links.forEach((l) => {
        const on = l.dataset.slug === slug;
        l.classList.toggle("border-accent", on);
        l.classList.toggle("text-ink", on);
        l.classList.toggle("text-muted", !on);
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-70px 0px -70% 0px", threshold: 0 }
    );
    document
      .querySelectorAll("article h2[id], article h3[id]")
      .forEach((h) => observer.observe(h));
  }
</script>
