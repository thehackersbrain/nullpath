---
import { getSearchIndex } from "../lib/wiki";
const index = await getSearchIndex();
---

<div
  id="palette"
  class="fixed inset-0 z-[100] hidden items-start justify-center bg-black/60 px-4 pt-[12vh]"
>
  <div
    class="w-full max-w-[640px] overflow-hidden rounded-md border border-line-strong bg-panel shadow-2xl"
  >
    <div class="flex items-center gap-2 border-b border-line px-3.5 py-3">
      <span class="text-accent">/</span>
      <input
        id="palette-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="search techniques, tools, attack paths…"
        class="w-full bg-transparent font-mono text-[15px] text-ink-bright outline-none placeholder:text-faint"
      />
      <kbd class="rounded border border-line px-1.5 py-0.5 text-[10px] text-dim"
        >esc</kbd
      >
    </div>
    <ul id="palette-results" class="max-h-[52vh] overflow-auto py-1.5"></ul>
    <div
      class="border-t border-line px-3.5 py-2 text-[11px] text-dim"
      id="palette-hint"
    >
      Type to filter · ↑ ↓ to move · ↵ to open
    </div>
  </div>
</div>

<script is:inline id="search-index" type="application/json" set:html={JSON.stringify(index)}
></script>

<script>
  interface Item {
    title: string;
    url: string;
    kind: string;
    section: string;
    tags: string[];
  }

  const raw = document.getElementById("search-index")?.textContent || "[]";
  const INDEX: Item[] = JSON.parse(raw);

  const palette = document.getElementById("palette")!;
  const input = document.getElementById("palette-input") as HTMLInputElement;
  const list = document.getElementById("palette-results")!;
  const hint = document.getElementById("palette-hint")!;
  let active = 0;
  let current: Item[] = [];

  function score(item: Item, q: string): number {
    const hay = (item.title + " " + item.section + " " + item.tags.join(" ")).toLowerCase();
    if (!q) return 1;
    if (item.title.toLowerCase().startsWith(q)) return 3;
    if (item.title.toLowerCase().includes(q)) return 2;
    if (hay.includes(q)) return 1;
    return 0;
  }

  function render() {
    const q = input.value.trim().toLowerCase();
    current = INDEX.map((i) => ({ i, s: score(i, q) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.i.title.localeCompare(b.i.title))
      .slice(0, 20)
      .map((x) => x.i);
    active = 0;
    list.innerHTML = current
      .map(
        (it, idx) => `
        <li>
          <a href="${it.url}" data-idx="${idx}"
             class="flex items-center gap-3 px-3.5 py-2.5 no-underline hover:no-underline ${
               idx === active ? "bg-hover" : ""
             }">
            <span class="flex-1 min-w-0">
              <span class="block truncate font-display text-[15px] text-ink">${it.title}</span>
              <span class="block truncate text-[11px] text-dim">${it.section} · ${it.kind}</span>
            </span>
          </a>
        </li>`
      )
      .join("");
    hint.textContent = current.length
      ? `${current.length} result${current.length === 1 ? "" : "s"} · ↑ ↓ to move · ↵ to open`
      : "No matches";
    highlight();
  }

  function highlight() {
    list.querySelectorAll("a").forEach((a, i) => {
      a.classList.toggle("bg-hover", i === active);
      if (i === active) a.scrollIntoView({ block: "nearest" });
    });
  }

  function open() {
    palette.classList.remove("hidden");
    palette.classList.add("flex");
    input.value = "";
    render();
    input.focus();
  }
  function close() {
    palette.classList.add("hidden");
    palette.classList.remove("flex");
  }

  document.getElementById("search-trigger")?.addEventListener("click", open);

  document.addEventListener("keydown", (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    const typing = tag === "INPUT" || tag === "TEXTAREA";
    const shown = !palette.classList.contains("hidden");
    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      shown ? close() : open();
    } else if (e.key === "/" && !typing && !shown) {
      e.preventDefault();
      open();
    } else if (e.key === "Escape" && shown) {
      close();
    } else if (shown && e.key === "ArrowDown") {
      e.preventDefault();
      active = Math.min(active + 1, current.length - 1);
      highlight();
    } else if (shown && e.key === "ArrowUp") {
      e.preventDefault();
      active = Math.max(active - 1, 0);
      highlight();
    } else if (shown && e.key === "Enter") {
      const target = current[active];
      if (target) window.location.href = target.url;
    }
  });

  input?.addEventListener("input", render);
  palette.addEventListener("click", (e) => {
    if (e.target === palette) close();
  });
</script>
