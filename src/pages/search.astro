---
import Shell from "../layouts/Shell.astro";
import { getSearchIndex } from "../lib/wiki";
const index = await getSearchIndex();
---

<Shell title="Search" description="Search the wiki.">
  <div class="max-w-[820px] px-5 pb-16 pt-6 md:px-8">
    <input
      id="q"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="search techniques, tools, attack paths…"
      class="w-full rounded border border-line-strong bg-inset px-4 py-3.5 font-mono text-[15px] text-ink-bright outline-none placeholder:text-faint focus:border-accent"
    />

    <div id="filters" class="mb-5 mt-3 flex flex-wrap gap-1.5 text-[11px]">
      <span class="self-center text-dim">kind</span>
      <button data-kind="all" class="kf chip chip-accent cursor-pointer">all</button>
      <button data-kind="concept" class="kf chip cursor-pointer">concept</button>
      <button data-kind="attack path" class="kf chip cursor-pointer">attack path</button>
      <button data-kind="reference" class="kf chip cursor-pointer">reference</button>
      <button data-kind="source" class="kf chip cursor-pointer">source</button>
    </div>

    <div id="count" class="mb-3 text-[11.5px] text-dim"></div>
    <div id="results"></div>
  </div>

  <script is:inline id="s-index" type="application/json" set:html={JSON.stringify(index)}
  ></script>

  <script>
    interface Item {
      title: string;
      url: string;
      kind: string;
      section: string;
      tags: string[];
    }
    const INDEX: Item[] = JSON.parse(
      document.getElementById("s-index")?.textContent || "[]"
    );
    const q = document.getElementById("q") as HTMLInputElement;
    const results = document.getElementById("results")!;
    const count = document.getElementById("count")!;
    const kfs = document.querySelectorAll<HTMLButtonElement>(".kf");
    let kind = "all";

    function run() {
      const term = q.value.trim().toLowerCase();
      const list = INDEX.filter((i) => {
        if (kind !== "all" && i.kind !== kind) return false;
        if (!term) return true;
        return (i.title + " " + i.section + " " + i.tags.join(" "))
          .toLowerCase()
          .includes(term);
      }).sort((a, b) => {
        if (!term) return a.title.localeCompare(b.title);
        const as = a.title.toLowerCase().startsWith(term) ? 0 : 1;
        const bs = b.title.toLowerCase().startsWith(term) ? 0 : 1;
        return as - bs || a.title.localeCompare(b.title);
      });

      count.textContent = `${list.length} result${list.length === 1 ? "" : "s"}${
        term ? ` for “${term}”` : ""
      }`;
      results.innerHTML = list
        .map(
          (r) => `
        <a href="${r.url}" class="block border-t border-line py-3.5 no-underline hover:bg-panel hover:no-underline">
          <div class="mb-1 flex gap-2 text-[11px] text-dim">
            <span>${r.section}</span><span class="flex-1"></span>
            <span class="text-accent">${r.kind}</span>
          </div>
          <div class="font-display text-[18px] text-ink">${r.title}</div>
          <div class="mt-1 text-[12px] text-dim">${r.tags.slice(0, 6).join(" · ")}</div>
        </a>`
        )
        .join("");
    }

    kfs.forEach((b) =>
      b.addEventListener("click", () => {
        kind = b.dataset.kind!;
        kfs.forEach((x) => x.classList.toggle("chip-accent", x === b));
        run();
      })
    );
    q.addEventListener("input", run);
    const initial = new URLSearchParams(location.search).get("q");
    if (initial) q.value = initial;
    q.focus();
    run();
  </script>
</Shell>
