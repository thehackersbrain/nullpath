---
import Shell from "../../layouts/Shell.astro";
import { getSections, fmtDate, type SectionView } from "../../lib/wiki";

export async function getStaticPaths() {
  const sections = await getSections();
  return sections.map((s) => ({ params: { section: s.id }, props: { section: s } }));
}

interface Props {
  section: SectionView;
}
const { section } = Astro.props as Props;
const sec = `oklch(0.74 0.15 ${section.hue})`;

const tagCounts = new Map<string, number>();
for (const p of section.pages)
  for (const t of p.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([t]) => t);

const subtitle = (title: string) => {
  const dash = title.split("—");
  if (dash.length > 1) return dash.slice(1).join("—").trim();
  const paren = title.match(/\(([^)]+)\)/);
  return paren ? paren[1] : "";
};
const heading = (title: string) =>
  title.replace(/^Attack Path:\s*/, "").split("—")[0].split("(")[0].trim();

const canonical = new URL(`/s/${section.id}`, Astro.site).href;
const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${section.title} · Nullpath`,
  description: section.blurb,
  url: canonical,
  inLanguage: "en",
  hasPart: section.pages.map((p) => ({
    "@type": "TechArticle",
    name: heading(p.title),
    url: new URL(p.url, Astro.site).href,
  })),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Sections", item: new URL("/sections", Astro.site).href },
    { "@type": "ListItem", position: 3, name: section.title, item: canonical },
  ],
};
---

<Shell
  title={section.title}
  description={section.blurb}
  currentSection={section.id}
  keywords={topTags}
  jsonLd={[collectionLd, breadcrumbLd]}
>
  <div class="px-5 pb-16 pt-8 md:px-8" style={`--sec: ${sec}`}>
    <nav class="mb-6 flex gap-2 text-[11.5px] text-dim">
      <a href="/" class="text-dim no-underline hover:text-ink-2 hover:no-underline">Home</a>
      <span>/</span>
      <a href="/sections" class="text-dim no-underline hover:text-ink-2 hover:no-underline">Sections</a>
      <span>/</span>
      <span class="text-ink-2">{section.title}</span>
    </nav>

    <div class="mb-7 max-w-[740px]">
      <div class="mb-3 flex items-center gap-2.5">
        <span class="dot"></span>
        <span class="kicker">{section.count} pages</span>
      </div>
      <h1 class="mb-3 font-display text-[32px] font-semibold tracking-[-0.02em] text-ink-bright md:text-[36px]">
        {section.title}
      </h1>
      <p class="text-[15px] leading-relaxed text-muted">{section.blurb}</p>
    </div>

    {
      topTags.length > 0 && (
        <div id="tag-filters" class="mb-6 flex flex-wrap gap-1.5">
          <button data-tag="all" class="tagf chip chip-accent cursor-pointer">all</button>
          {topTags.map((t) => (
            <button data-tag={t} class="tagf chip cursor-pointer hover:border-line-strong">
              {t}
            </button>
          ))}
        </div>
      )
    }

    <div class="card overflow-hidden">
      <div class="grid grid-cols-[minmax(0,3fr)_110px_92px] gap-3 border-b border-line bg-panel-2 px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.12em] text-dim md:grid-cols-[minmax(0,3fr)_120px_150px_88px]">
        <span>Page</span>
        <span>Kind</span>
        <span class="hidden md:block">Tags</span>
        <span>Updated</span>
      </div>
      {
        section.pages.map((p) => (
          <a
            href={p.url}
            data-tags={p.tags.join(" ")}
            class="row grid grid-cols-[minmax(0,3fr)_110px_92px] items-center gap-3 border-t border-line-soft px-4 py-3 no-underline transition-colors hover:bg-hover hover:no-underline md:grid-cols-[minmax(0,3fr)_120px_150px_88px]"
          >
            <div class="min-w-0">
              <div class="mb-0.5 truncate text-[13.5px] text-ink">{heading(p.title)}</div>
              <div class="truncate text-[12px] text-dim">{subtitle(p.title)}</div>
            </div>
            <span class="text-[11px]"><span class="chip">{p.kind}</span></span>
            <span class="hidden truncate font-mono text-[11px] text-dim md:block">
              {p.tags.slice(0, 2).join(", ")}
            </span>
            <span class="font-mono text-[11px] text-faint">{fmtDate(p.updated)}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-3.5 text-[11.5px] text-dim">
      <span id="row-count">{section.pages.length}</span> pages in this section
    </div>
  </div>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>(".tagf");
    const rows = document.querySelectorAll<HTMLElement>(".row");
    const count = document.getElementById("row-count");
    filters.forEach((btn) =>
      btn.addEventListener("click", () => {
        const tag = btn.dataset.tag!;
        filters.forEach((b) => b.classList.toggle("chip-accent", b === btn));
        let shown = 0;
        rows.forEach((r) => {
          const match = tag === "all" || (r.dataset.tags || "").split(" ").includes(tag);
          r.classList.toggle("hidden", !match);
          if (match) shown++;
        });
        if (count) count.textContent = String(shown);
      })
    );
  </script>
</Shell>
